PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/tech_magnate_assessment

# From https://app.dataforseo.com/api-access  (not your website password)
DATAFORSEO_LOGIN=your_login_email
DATAFORSEO_PASSWORD=your_api_password
DATAFORSEO_BASE_URL=https://api.dataforseo.com/v3

# Local / code-review without keys → true
# Live QA with real account → false
DATAFORSEO_MOCK=true

QUEUE_CONCURRENCY=3
MAX_CSV_ROWS=1000
